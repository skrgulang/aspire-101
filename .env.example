# Aspire 101 V2 — browser-safe Supabase values
# Add local values in .env.local and deployment values in Vercel Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://ikxjemnugoodfuxjaqoe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=https://your-v2-preview-or-production-domain.example

# Product analytics / production observability — browser-safe project identifiers.
# Amplitude project API key (Settings -> Projects -> default -> General).
NEXT_PUBLIC_AMPLITUDE_API_KEY=replace_with_amplitude_project_api_key
# Datadog RUM application credentials. These are browser client identifiers,
# not Datadog API/application keys. Never expose a Datadog API key here.
NEXT_PUBLIC_DATADOG_APPLICATION_ID=replace_with_datadog_rum_application_id
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=replace_with_datadog_rum_client_token
NEXT_PUBLIC_APP_ENV=production

# Server-only Supabase key. NEVER expose this in NEXT_PUBLIC_* variables or client code.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Aspire Live reminders — server-only secret used by Vercel Cron.
# Use a long random value. Vercel sends it as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=replace_with_long_random_secret

# Aspire Safety Intelligence — server-only OpenAI API key.
# Used by app/api/moderation/request with omni-moderation-latest for text + image moderation.
# NEVER put this in NEXT_PUBLIC_* variables or browser code.
OPENAI_API_KEY=sk-replace_me
# Optional lower-cost vision model for Aspire's viewpoint-neutral public political-content policy classifier.
# Defaults to gpt-5.6-luna.
ASPIRE_POLICY_MODEL=gpt-5.6-luna

# Stripe sandbox while Aspire payments are under development. NEVER commit real values.
STRIPE_SECRET_KEY=sk_test_replace_me
# Separate endpoint signing secrets; both may point to /api/stripe/webhook.
# Keep the legacy STRIPE_WEBHOOK_SECRET as a temporary fallback during rotation.
STRIPE_WEBHOOK_SECRET_LIVE=whsec_live_replace_me
STRIPE_WEBHOOK_SECRET_TEST=whsec_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Production-only, comma-separated Supabase auth user UUIDs permitted during
# the controlled Live Mode pilot. Keep empty to fail closed for every user.
STRIPE_LIVE_PILOT_USER_IDS=

# Shipping — server-only Shippo API token. Use shippo_test_* during development;
# Shippo can use its own FedEx account or a connected FedEx carrier account.
SHIPPO_API_KEY=shippo_test_replace_me
# Random token used in the Shippo webhook URL/header. Never expose in NEXT_PUBLIC_*.
SHIPPO_WEBHOOK_TOKEN=replace_with_long_random_shipping_webhook_token
# Comma-separated normalized carrier names. Keep FedEx only for the initial beta.
SHIPPING_ALLOWED_CARRIERS=fedex

# Campus Ambassador recruiting email workflow (server-only).
# Namecheap Private Email SMTP. Prefer an Application Password over the mailbox master password.
# Namecheap defaults: mail.privateemail.com:465 with SSL/TLS.
AMBASSADOR_SMTP_HOST=mail.privateemail.com
AMBASSADOR_SMTP_PORT=465
AMBASSADOR_SMTP_SECURE=true
AMBASSADOR_SMTP_USER=team@aspires101.com
AMBASSADOR_SMTP_PASSWORD=replace_with_namecheap_private_email_application_password
AMBASSADOR_FROM_EMAIL="Aspire 101 <team@aspires101.com>"
AMBASSADOR_ADMIN_EMAIL=team@aspires101.com
# Optional. Defaults to AMBASSADOR_ADMIN_EMAIL / team@aspires101.com when omitted.
AMBASSADOR_REPLY_TO_EMAIL=team@aspires101.com

# Resend transactional email lifecycle webhook (server-only).
# Copy the signing secret returned when creating the Resend webhook.
RESEND_WEBHOOK_SIGNING_SECRET=whsec_replace_me

# Marketplace fee policy is stored server-side in Supabase public.fee_policies.
# Purdue beta: orders under $10 use a flat $0.50 buyer Aspire Protect fee; $10+ uses requester 6% + $0.49 (min $0.99 / max $9.99). Provider fee remains 8%, tips 0%.
# Historical transactions snapshot the exact fee policy used at checkout.

# Legacy projects can temporarily use this instead if needed:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-legacy-anon-key

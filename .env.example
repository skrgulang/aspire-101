# Aspire 101 V2 — browser-safe Supabase values
# Add local values in .env.local and deployment values in Vercel Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://ikxjemnugoodfuxjaqoe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=https://your-v2-preview-or-production-domain.example

# Server-only Supabase key. NEVER expose this in NEXT_PUBLIC_* variables or client code.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Aspire Safety Intelligence — server-only OpenAI API key.
# Used by app/api/moderation/request with omni-moderation-latest for text + image moderation.
# NEVER put this in NEXT_PUBLIC_* variables or browser code.
OPENAI_API_KEY=sk-replace_me

# Stripe sandbox while Aspire payments are under development. NEVER commit real values.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Marketplace fee policy is stored server-side in Supabase public.fee_policies.
# Purdue beta default: requester 6% + $0.49 (min $0.99 / max $9.99), provider 8%, tips 0%, minimum paid order $10.
# Historical transactions snapshot the exact fee policy used at checkout.

# Legacy projects can temporarily use this instead if needed:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-legacy-anon-key
